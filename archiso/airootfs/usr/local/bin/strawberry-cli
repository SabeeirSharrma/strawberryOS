#!/usr/bin/env bash
# strawberry-cli — thin wrapper that talks to strawberryd over Unix socket
# Phase 0: skeleton with subcommands stubbed out

set -euo pipefail

SOCKET="/run/strawberryd.sock"

usage() {
    cat <<EOF
Strawberry OS CLI

Usage: strawberry-cli <command> [args]

Commands:
  status              Show daemon status
  miner list          List installed miners
  miner start <name>  Start a miner
  miner stop <name>   Stop a miner
  wallet list         List wallets
  wallet new <coin>   Generate a new wallet
  wallet set <coin> <address>  Set an existing address
  config show         Show current config
  config reload       Reload config from disk
  setup               Run the post-install wizard
  update check        Check for system updates

Run 'strawberry-cli <command> --help' for more info on a command.
EOF
}

cmd_status() {
    if [ -S "$SOCKET" ]; then
        echo "strawberryd: running (socket: $SOCKET)"
    else
        echo "strawberryd: not running"
        echo "Start it with: sudo systemctl start strawberryd"
        return 1
    fi
}

case "${1:-}" in
    status)
        cmd_status
        ;;
    miner)
        echo "Miner management — not yet implemented (Phase 0 skeleton)"
        echo "  Subcommands: list, start, stop"
        ;;
    wallet)
        echo "Wallet management — not yet implemented (Phase 1)"
        echo "  Subcommands: list, new, set"
        ;;
    config)
        echo "Configuration — not yet implemented (Phase 1)"
        echo "  Subcommands: show, reload"
        ;;
    setup)
        echo "Post-install wizard — not yet implemented (Phase 0+)"
        ;;
    update)
        echo "Update system — not yet implemented (Phase 1+)"
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'strawberry-cli --help' for usage." >&2
        exit 1
        ;;
esac
