#!/usr/bin/env bash
# strawberry-cli — talks to strawberryd over Unix socket
# Forwards commands and prints responses.

set -euo pipefail

SOCKET="/run/strawberryd.sock"

usage() {
    cat <<EOF
Strawberry OS CLI

Usage: strawberry-cli <command> [args]

Commands:
  ping                  Ping the daemon
  version               Show daemon version
  status                Show daemon status
  config show           Show current config
  miner list            List installed miners
  wallet list           List wallets
  wallet new <coin>     Generate a new wallet (monero)
  wallet set <coin> <address>  Set an existing address
  pool list [coin]      List pools (optionally filtered by coin)
  pool ping <name>      Measure latency to a pool
  pool set <coin> <name>      Set pool for a coin by name
  pool set <coin> <addr> <port>  Set pool for a coin by address
  help                  Show available commands

Run 'strawberry-cli <command> --help' for more info on a command.
EOF
}

cmd_status() {
    if [ -S "$SOCKET" ]; then
        echo "strawberryd: running (socket: $SOCKET)"
    else
        echo "strawberryd: not running"
        echo "Start it with: systemctl start strawberryd"
        return 1
    fi
}

# Send a command to the daemon via the Unix socket
send_cmd() {
    local cmd="$1"
    if [ ! -S "$SOCKET" ]; then
        echo "Error: strawberryd is not running (socket not found: $SOCKET)" >&2
        echo "Start it with: systemctl start strawberryd" >&2
        exit 1
    fi
    (echo "$cmd"; sleep 10) | socat - UNIX-CONNECT:"$SOCKET" 2>/dev/null
}

case "${1:-}" in
    ping)
        send_cmd "ping"
        ;;
    version)
        send_cmd "version"
        ;;
    status)
        cmd_status
        echo "---"
        send_cmd "status"
        ;;
    config)
        case "${2:-}" in
            show)
                send_cmd "config show"
                ;;
            *)
                echo "Usage: strawberry-cli config show" >&2
                exit 1
                ;;
        esac
        ;;
    miner)
        case "${2:-}" in
            list)
                send_cmd "miner list"
                ;;
            *)
                echo "Usage: strawberry-cli miner list" >&2
                exit 1
                ;;
        esac
        ;;
    wallet)
        case "${2:-}" in
            list)
                send_cmd "wallet list"
                ;;
            new)
                if [ -z "${3:-}" ]; then
                    echo "Usage: strawberry-cli wallet new <coin>" >&2
                    echo "Supported coins: monero" >&2
                    exit 1
                fi
                send_cmd "wallet new $3"
                ;;
            set)
                if [ -z "${3:-}" ] || [ -z "${4:-}" ]; then
                    echo "Usage: strawberry-cli wallet set <coin> <address>" >&2
                    exit 1
                fi
                send_cmd "wallet set $3 $4"
                ;;
            *)
                echo "Usage: strawberry-cli wallet [list|new|set]" >&2
                exit 1
                ;;
        esac
        ;;
    pool)
        case "${2:-}" in
            list)
                if [ -n "${3:-}" ]; then
                    send_cmd "pool list $3"
                else
                    send_cmd "pool list"
                fi
                ;;
            ping)
                if [ -z "${3:-}" ]; then
                    echo "Usage: strawberry-cli pool ping <name>" >&2
                    exit 1
                fi
                send_cmd "pool ping $3"
                ;;
            set)
                if [ -z "${3:-}" ] || [ -z "${4:-}" ]; then
                    echo "Usage: strawberry-cli pool set <coin> <name|address port>" >&2
                    exit 1
                fi
                if [ -n "${5:-}" ]; then
                    send_cmd "pool set $3 $4 $5"
                else
                    send_cmd "pool set $3 $4"
                fi
                ;;
            *)
                echo "Usage: strawberry-cli pool [list|ping|set]" >&2
                exit 1
                ;;
        esac
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        # Forward unknown commands to daemon
        send_cmd "$*"
        ;;
esac
